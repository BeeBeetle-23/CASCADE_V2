# Backend (copy to backend/.env or export in your shell). Never put keys in frontend/Vite variables.
DATABASE_URL=sqlite:///./cascade.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20
# Optional: enables LLM schema mapping. Leave empty to use the deterministic parser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
